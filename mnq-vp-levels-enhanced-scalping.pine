//@version=6
indicator("MNQ VP Levels + BoS + Volume [Scalping]", overlay=true, max_bars_back=5000, max_lines_count=500, max_boxes_count=500)

// ══════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════
int n_bkts = input.int(300, "Buckets (session/day)", minval=100, maxval=500, group="Volume Profile")
float bsz_sd = input.float(0.5, "Bucket size – session/day (pts)", minval=0.25, step=0.25, group="Volume Profile")
float bsz_wk = input.float(2.0, "Bucket size – week (pts)", minval=0.25, step=0.25, group="Volume Profile")
float va_pct = input.float(0.70, "Value area %", minval=0.50, maxval=0.95, step=0.01, group="Volume Profile")
float alrt_d = input.float(2.0, "Alert proximity (pts)", minval=0.25, step=0.25, group="Alerts")
bool wh_mode = input.bool(false, "JSON webhook payload", group="Alerts")
bool s_cur = input.bool(true, "Current session", group="Display")
bool s_pd = input.bool(true, "Previous day", group="Display")
bool s_pw = input.bool(true, "Previous week", group="Display")
bool s_nodes = input.bool(true, "HVN / LVN", group="Display")

// BREAK OF STRUCTURE INPUTS
int bos_lookback = input.int(5, "Break of Structure lookback bars", minval=3, maxval=20, group="Break of Structure")
float bos_buffer = input.float(0.25, "BoS buffer (pts)", minval=0.0, step=0.25, group="Break of Structure")
bool show_bos_lines = input.bool(true, "Show BoS swing lines", group="Break of Structure")

// VOLUME INPUTS
float vol_ma_length = input.int(20, "Volume MA length", minval=5, maxval=50, group="Volume")
float vol_surge_threshold = input.float(1.5, "Volume surge multiplier", minval=1.0, step=0.1, group="Volume")
bool show_vol_bars = input.bool(true, "Highlight volume surges", group="Volume")

// RANGE/VOLATILITY FILTER (OPTIONAL - DISABLED BY DEFAULT)
float atr_length = input.int(14, "ATR length for volatility", minval=5, maxval=30, group="Volatility Filter")
float range_filter_pct = input.float(0.50, "Daily range % to filter chop (0.5 = 0.5%)", minval=0.1, maxval=2.0, step=0.1, group="Volatility Filter")
bool use_range_filter = input.bool(false, "Enable range/chop filter (disable for all days)", group="Volatility Filter")

color c_cs_poc = input.color(#FFD700, "Current POC", group="Colors")
color c_cs_va = input.color(color.new(#4488FF, 0), "Current VAH / VAL", group="Colors")
color c_pd_poc = input.color(#FF8C00, "Prev day POC", group="Colors")
color c_pd_va = input.color(color.new(#FF8C00, 30), "Prev day VAH / VAL", group="Colors")
color c_pw_poc = input.color(#9B59B6, "Prev week POC", group="Colors")
color c_pw_va = input.color(color.new(#9B59B6, 30), "Prev week VAH / VAL", group="Colors")
color c_hvn = input.color(color.new(#00CC66, 0), "HVN", group="Colors")
color c_lvn = input.color(color.new(#FF3333, 0), "LVN", group="Colors")
color c_bos_buy = input.color(color.new(#00FF00, 40), "BoS Buy signal", group="Colors")
color c_bos_sell = input.color(color.new(#FF0000, 40), "BoS Sell signal", group="Colors")

// ══════════════════════════════════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════════════════════════════════
int HALF_SD = math.round(n_bkts / 2)
int HALF_WK = math.round(n_bkts / 2)
int MAX_N = 8

// ══════════════════════════════════════════════════════════════════
// SESSION FLAGS
// ══════════════════════════════════════════════════════════════════
bool is_rth_session = not na(time("1", "0930-1600"))
bool rth_open = is_rth_session and not is_rth_session[1]
bool is_mon = dayofweek == dayofweek.monday
bool wk_open = rth_open and is_mon

// ══════════════════════════════════════════════════════════════════
// VP ARRAYS
// ══════════════════════════════════════════════════════════════════
var float[] cs_vp = array.new_float(500, 0.0)
var float[] wk_vp = array.new_float(500, 0.0)
var float cs_ref = na
var float wk_ref = na

// ══════════════════════════════════════════════════════════════════
// STORED LEVELS
// ══════════════════════════════════════════════════════════════════
var float cs_poc = na
var float cs_vah = na
var float cs_val = na
var float pd_poc = na
var float pd_vah = na
var float pd_val = na
var float pw_poc = na
var float pw_vah = na
var float pw_val = na

var float[] cs_hvn = array.new_float(0)
var float[] cs_lvn = array.new_float(0)
var float[] pd_hvn = array.new_float(0)
var float[] pd_lvn = array.new_float(0)
var float[] pw_hvn = array.new_float(0)
var float[] pw_lvn = array.new_float(0)

// ══════════════════════════════════════════════════════════════════
// BREAK OF STRUCTURE TRACKING
// ══════════════════════════════════════════════════════════════════
var float swing_high = na
var float swing_low = na
var int swing_high_bar = na
var int swing_low_bar = na
bool bos_buy = false
bool bos_sell = false

// Update swing highs/lows
if high > swing_high or na(swing_high)
    swing_high := high
    swing_high_bar := bar_index

if low < swing_low or na(swing_low)
    swing_low := low
    swing_low_bar := bar_index

// Detect BoS signals
bos_buy := close > swing_high + bos_buffer and bar_index - swing_high_bar < bos_lookback
bos_sell := close < swing_low - bos_buffer and bar_index - swing_low_bar < bos_lookback

// ══════════════════════════════════════════════════════════════════
// VOLUME ANALYSIS
// ══════════════════════════════════════════════════════════════════
float vol_ma = ta.sma(volume, int(vol_ma_length))
bool vol_surge = volume > vol_ma * vol_surge_threshold
barcolor(show_vol_bars and vol_surge ? color.new(color.yellow, 70) : na)

// ══════════════════════════════════════════════════════════════════
// VOLATILITY & RANGE DETECTION (Filter choppy/ranging days)
// ══════════════════════════════════════════════════════════════════
float atr = ta.atr(int(atr_length))
float daily_range = high - low
float daily_range_pct = (daily_range / close) * 100
bool is_low_volatility = atr < (close * (range_filter_pct / 100))

// Support/Resistance confirmation
bool close_above_open = close > open
bool close_below_open = close < open

// ══════════════════════════════════════════════════════════════════
// FUNCTIONS
// ══════════════════════════════════════════════════════════════════
f_idx(float p, float ref, float bsz, int half) =>
    math.max(0, math.min(499, math.round((p - ref) / bsz) + half))

f_add(float[] vp, float ref, float bsz, int half) =>
    float rng = high - low
    if rng < syminfo.mintick
        int i = f_idx(close, ref, bsz, half)
        array.set(vp, i, array.get(vp, i) + volume)
    else
        int ilo = f_idx(low, ref, bsz, half)
        int ihi = f_idx(high, ref, bsz, half)
        for i = ilo to ihi
            float blo = ref + (i - half) * bsz
            float bhi = blo + bsz
            float wt = math.max(0.0, (math.min(high, bhi) - math.max(low, blo)) / rng)
            array.set(vp, i, array.get(vp, i) + volume * wt)

f_poc(float[] vp, float ref, float bsz, int half) =>
    int pi = 0
    float pv = 0.0
    for i = 0 to 499
        float v = array.get(vp, i)
        if v > pv
            pv := v
            pi := i
    ref + (pi - half) * bsz + bsz * 0.5

f_va(float[] vp, float ref, float bsz, int half, float poc) =>
    float tgt = array.sum(vp) * va_pct
    int pi = math.max(0, math.min(499, math.round((poc - ref) / bsz) + half))
    float acc = array.get(vp, pi)
    int lo = pi
    int hi = pi
    int max_iter = 250
    int iter = 0
    while acc < tgt and (lo > 0 or hi < 499) and iter < max_iter
        float up = hi < 499 ? array.get(vp, hi + 1) : 0.0
        float dn = lo > 0 ? array.get(vp, lo - 1) : 0.0
        if up >= dn and hi < 499
            hi += 1
            acc += up
        else if lo > 0
            lo -= 1
            acc += dn
        else
            break
        iter += 1
    [ref + (hi - half) * bsz + bsz, ref + (lo - half) * bsz]

f_nodes(float[] vp, float ref, float bsz, int half, float[] hvn, float[] lvn) =>
    array.clear(hvn)
    array.clear(lvn)
    float mean = array.sum(vp) / 500
    for i = 1 to 498
        float cv = array.get(vp, i)
        float pv = array.get(vp, i - 1)
        float nv = array.get(vp, i + 1)
        float px = ref + (i - half) * bsz + bsz * 0.5
        if cv > pv and cv > nv and cv > mean and array.size(hvn) < MAX_N
            array.push(hvn, px)
        if cv < pv and cv < nv and cv < mean and cv > 0 and array.size(lvn) < MAX_N
            array.push(lvn, px)

f_copy(float[] src, float[] dst) =>
    array.clear(dst)
    for v in src
        array.push(dst, v)

// ══════════════════════════════════════════════════════════════════
// SESSION TRANSITIONS
// ══════════════════════════════════════════════════════════════════
if rth_open
    if not na(cs_ref)
        pd_poc := cs_poc
        pd_vah := cs_vah
        pd_val := cs_val
        f_copy(cs_hvn, pd_hvn)
        f_copy(cs_lvn, pd_lvn)
        array.fill(cs_vp, 0.0)
        cs_ref := open
        cs_poc := na
        cs_vah := na
        cs_val := na

if wk_open
    if not na(wk_ref)
        pw_poc := f_poc(wk_vp, wk_ref, bsz_wk, HALF_WK)
        [wh, wl] = f_va(wk_vp, wk_ref, bsz_wk, HALF_WK, pw_poc)
        pw_vah := wh
        pw_val := wl
        f_nodes(wk_vp, wk_ref, bsz_wk, HALF_WK, pw_hvn, pw_lvn)
        array.fill(wk_vp, 0.0)
        wk_ref := open

// ══════════════════════════════════════════════════════════════════
// BAR ACCUMULATION
// ══════════════════════════════════════════════════════════════════
if is_rth_session
    if na(cs_ref)
        cs_ref := open
    f_add(cs_vp, cs_ref, bsz_sd, HALF_SD)
    cs_poc := f_poc(cs_vp, cs_ref, bsz_sd, HALF_SD)
    if bar_index % 5 == 0
        [vh, vl] = f_va(cs_vp, cs_ref, bsz_sd, HALF_SD, cs_poc)
        cs_vah := vh
        cs_val := vl
    if bar_index % 5 == 0
        f_nodes(cs_vp, cs_ref, bsz_sd, HALF_SD, cs_hvn, cs_lvn)
    if na(wk_ref)
        wk_ref := open
    f_add(wk_vp, wk_ref, bsz_wk, HALF_WK)

// ══════════════════════════════════════════════════════════════════
// LINE OBJECTS
// ══════════════════════════════════════════════════════════════════
f_ln(color col, int w, bool dashed) =>
    line.new(bar_index, na, bar_index + 1, na, extend=extend.right, color=col, width=w, style=dashed ? line.style_dashed : line.style_solid)

var line l_cs_poc = f_ln(c_cs_poc, 2, false)
var line l_cs_vah = f_ln(c_cs_va, 1, true)
var line l_cs_val = f_ln(c_cs_va, 1, true)
var line l_pd_poc = f_ln(c_pd_poc, 2, false)
var line l_pd_vah = f_ln(c_pd_va, 1, true)
var line l_pd_val = f_ln(c_pd_va, 1, true)
var line l_pw_poc = f_ln(c_pw_poc, 2, false)
var line l_pw_vah = f_ln(c_pw_va, 1, true)
var line l_pw_val = f_ln(c_pw_va, 1, true)

f_upd(line ln, float y) =>
    if not na(y)
        line.set_y1(ln, y)
        line.set_y2(ln, y)
        line.set_x1(ln, bar_index)

if s_cur
    f_upd(l_cs_poc, cs_poc)
    f_upd(l_cs_vah, cs_vah)
    f_upd(l_cs_val, cs_val)
if s_pd
    f_upd(l_pd_poc, pd_poc)
    f_upd(l_pd_vah, pd_vah)
    f_upd(l_pd_val, pd_val)
if s_pw
    f_upd(l_pw_poc, pw_poc)
    f_upd(l_pw_vah, pw_vah)
    f_upd(l_pw_val, pw_val)

// ══════════════════════════════════════════════════════════════════
// HVN / LVN NODE LINES
// ══════════════════════════════════════════════════════════════════
var line[] ll_cs_hvn = array.new<line>(0)
var line[] ll_cs_lvn = array.new<line>(0)
var line[] ll_pd_hvn = array.new<line>(0)
var line[] ll_pd_lvn = array.new<line>(0)
var line[] ll_pw_hvn = array.new<line>(0)
var line[] ll_pw_lvn = array.new<line>(0)

f_draw_nodes(float[] lvls, line[] lns, color col) =>
    for ln in lns
        line.delete(ln)
    array.clear(lns)
    for lvl in lvls
        ln = line.new(bar_index - 5, lvl, bar_index, lvl, extend=extend.right, color=col, width=1, style=line.style_dotted)
        array.push(lns, ln)

if s_nodes
    if rth_open
        f_draw_nodes(pd_hvn, ll_pd_hvn, c_hvn)
        f_draw_nodes(pd_lvn, ll_pd_lvn, c_lvn)
    if wk_open
        f_draw_nodes(pw_hvn, ll_pw_hvn, c_hvn)
        f_draw_nodes(pw_lvn, ll_pw_lvn, c_lvn)
    if is_rth_session and bar_index % 5 == 0
        f_draw_nodes(cs_hvn, ll_cs_hvn, c_hvn)
        f_draw_nodes(cs_lvn, ll_cs_lvn, c_lvn)

// ══════════════════════════════════════════════════════════════════
// BUY / SELL SIGNALS (REFINED)
// ══════════════════════════════════════════════════════════════════
f_near(float lvl) => not na(lvl) and math.abs(close - lvl) <= alrt_d

// Trend detection
bool is_higher_high = high > high[1]
bool is_lower_low = low < low[1]
bool is_bullish_close = close > open
bool is_bearish_close = close < open

// Trend bias: Strong uptrend = suppress sells, strong downtrend = suppress buys
float ema_fast = ta.ema(close, 5)
float ema_slow = ta.ema(close, 20)
bool trend_bullish = close > ema_slow and ema_fast > ema_slow
bool trend_bearish = close < ema_slow and ema_fast < ema_slow
bool trend_neutral = not trend_bullish and not trend_bearish

// Plot EMAs for visual confirmation
plot_ema5 = plot(ema_fast, "EMA 5", color=color.new(color.blue, 0), linewidth=2)
plot_ema20 = plot(ema_slow, "EMA 20", color=color.new(color.orange, 0), linewidth=2)

// Fill between EMAs based on trend (darker background)
fill_color = trend_bullish ? color.new(color.blue, 30) : trend_bearish ? color.new(color.red, 30) : color.new(color.gray, 50)
fill(plot_ema5, plot_ema20, fill_color, title="EMA Fill")

// MULTI-TIMEFRAME TREND ANALYSIS
// Function to get trend for any timeframe
f_get_trend(string tf) =>
    float e5 = request.security(syminfo.tickerid, tf, ta.ema(close, 5))
    float e20 = request.security(syminfo.tickerid, tf, ta.ema(close, 20))
    float c = request.security(syminfo.tickerid, tf, close)
    if c > e20 and e5 > e20
        "Bullish"
    else if c < e20 and e5 < e20
        "Bearish"
    else
        "Neutral"

string trend_15m = f_get_trend("15")
string trend_30m = f_get_trend("30")
string trend_1h = f_get_trend("60")
string trend_4h = f_get_trend("240")
string trend_1d = f_get_trend("D")

// Color coding for dashboard
get_trend_color(string trend) => trend == "Bullish" ? color.green : trend == "Bearish" ? color.red : color.gray

// DASHBOARD in upper right
table dash = table.new(position=position.top_right, columns=2, rows=6, bgcolor=color.new(color.black, 40), border_color=color.gray, border_width=1)
table.cell(dash, 0, 0, "Timeframe", text_color=color.white, bgcolor=color.new(color.black, 60))
table.cell(dash, 1, 0, "Trend", text_color=color.white, bgcolor=color.new(color.black, 60))
table.cell(dash, 0, 1, "15m", text_color=color.white)
table.cell(dash, 1, 1, trend_15m, text_color=get_trend_color(trend_15m))
table.cell(dash, 0, 2, "30m", text_color=color.white)
table.cell(dash, 1, 2, trend_30m, text_color=get_trend_color(trend_30m))
table.cell(dash, 0, 3, "1h", text_color=color.white)
table.cell(dash, 1, 3, trend_1h, text_color=get_trend_color(trend_1h))
table.cell(dash, 0, 4, "4h", text_color=color.white)
table.cell(dash, 1, 4, trend_4h, text_color=get_trend_color(trend_4h))
table.cell(dash, 0, 5, "1D", text_color=color.white)
table.cell(dash, 1, 5, trend_1d, text_color=get_trend_color(trend_1d))

bool near_support = f_near(cs_val) or f_near(pd_val) or f_near(pw_val)
bool near_resist = f_near(cs_vah) or f_near(pd_vah) or f_near(pw_vah)

bool hvn_buy = false
bool hvn_sell = false

if s_nodes
    for lvl in cs_hvn
        if f_near(lvl)
            if close < lvl
                hvn_buy := true
            if close > lvl
                hvn_sell := true
    for lvl in pd_hvn
        if f_near(lvl)
            if close < lvl
                hvn_buy := true
            if close > lvl
                hvn_sell := true
    for lvl in pw_hvn
        if f_near(lvl)
            if close < lvl
                hvn_buy := true
            if close > lvl
                hvn_sell := true

// REFINED SIGNALS WITH TREND BIAS
// Only generate signals if NOT in choppy/low volatility mode
bool signals_enabled = is_rth_session and (not use_range_filter or not is_low_volatility)

// BUY: Support level touch + bullish close OR BoS breakup
bool buy_signal = signals_enabled and ((near_support and close_above_open) or bos_buy)

// SELL: During uptrend - only BoS, During neutral/downtrend - resistance + bearish
bool sell_signal = signals_enabled and (bos_sell or (not trend_bullish and near_resist and close_below_open))

plotshape(buy_signal, "BUY", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small, text="B")
plotshape(sell_signal, "SELL", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small, text="S")

// BoS visualization
if show_bos_lines
    if bos_buy
        box.new(bar_index - 1, swing_low, bar_index, high, border_color=c_bos_buy, bgcolor=c_bos_buy)
    if bos_sell
        box.new(bar_index - 1, low, bar_index, swing_high, border_color=c_bos_sell, bgcolor=c_bos_sell)

// ══════════════════════════════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════════════════════════════
f_msg(string tf, string kind, float lvl) => wh_mode ? '{"ticker":"' + syminfo.ticker + '","price":' + str.tostring(close, "#.##") + ',"tf":"' + tf + '","level":"' + kind + '","level_price":' + str.tostring(lvl, "#.##") + ',"side":"' + (close >= lvl ? "above" : "below") + '"}' : "MNQ WATCH @ " + str.tostring(close, "#.##") + " | " + tf + " " + kind + " " + str.tostring(lvl, "#.##")

if buy_signal
    string bsrc = bos_buy ? "BoS breakout" : f_near(pd_val) ? "PD VAL " + str.tostring(pd_val, "#.##") : f_near(pw_val) ? "PW VAL " + str.tostring(pw_val, "#.##") : f_near(cs_val) ? "CS VAL " + str.tostring(cs_val, "#.##") : "HVN fade"
    alert("MNQ BUY @ " + str.tostring(close, "#.##") + " | " + bsrc + " | VOL SURGE", alert.freq_once_per_bar_close)

if sell_signal
    string ssrc = bos_sell ? "BoS breakout" : f_near(pd_vah) ? "PD VAH " + str.tostring(pd_vah, "#.##") : f_near(pw_vah) ? "PW VAH " + str.tostring(pw_vah, "#.##") : f_near(cs_vah) ? "CS VAH " + str.tostring(cs_vah, "#.##") : "HVN fade"
    alert("MNQ SELL @ " + str.tostring(close, "#.##") + " | " + ssrc + " | VOL SURGE", alert.freq_once_per_bar_close)

if s_cur and f_near(cs_poc)
    alert(f_msg("CS", "POC", cs_poc), alert.freq_once_per_bar_close)

alertcondition(buy_signal, "BUY signal")
alertcondition(sell_signal, "SELL signal")
alertcondition(bos_buy, "BoS Buy breakout")
alertcondition(bos_sell, "BoS Sell breakout")