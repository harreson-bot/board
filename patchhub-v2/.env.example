# PatchHub Phase 2 - Environment Configuration
NODE_ENV=production
PORT=3000

# Database (SQLite - no connection string needed)
# DB_PATH defaults to ./patchhub.db if not set
# DB_PATH=/home/patch_app/app.patchhub.solutions/patchhub.db

# JWT Secret (change this to a random string!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Upload directory
UPLOAD_DIR=./uploads

# Frontend URL (for CORS)
FRONTEND_URL=https://app.patchhub.solutions
